<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Neither NU1902 nor NU1903 is suppressed. Both were introduced for named advisories that
         have since cleared (moderate: transitive OpenTelemetry / MessagePack+Scriban; high: the
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 floor, CVE-2025-6965). A suppression written for one
         package outlives that package's fix and then silently swallows the next advisory in the
         same class, which is how the NU1903 suppression in this ecosystem came back three
         separate times. Verified 2026-09-11: a forced restore with the moderate suppression
         lifted reports no NU190x at all in either repository. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>IronHive Agent</Product>
    <Copyright>Copyright (c) iyulab</Copyright>
    <RepositoryUrl>https://github.com/iyulab/ironhive-agent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Version: Update this to trigger a new release -->
  <PropertyGroup>
    <Version>0.10.3</Version>
  </PropertyGroup>

  <!-- Local NuGet package source for development -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../../local-packages')">
    <RestoreAdditionalProjectSources>
        $(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../../local-packages
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Release build: exclude PDB files -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
