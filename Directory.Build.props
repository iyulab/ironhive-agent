<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Ignore NU1902 (known moderate vulnerability in transitive OpenTelemetry deps — no fix available yet) -->
    <!-- NU1903 is deliberately NOT suppressed: the former SQLitePCLRaw.lib.e_sqlite3 2.1.11
         (CVE-2025-6965) transitive floor cleared once upstream shipped 2.1.12 (2026-07-09) and
         IronHive.Core 0.14.0 started pinning it directly. A vulnerable transitive must fail the
         build, not be hidden. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>IronHive Agent</Product>
    <Copyright>Copyright (c) iyulab</Copyright>
    <RepositoryUrl>https://github.com/iyulab/ironhive-agent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Version: Update this to trigger a new release -->
  <PropertyGroup>
    <Version>0.9.4</Version>
  </PropertyGroup>

  <!-- Local NuGet package source for development -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../../local-packages')">
    <RestoreAdditionalProjectSources>
        $(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../../local-packages
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Release build: exclude PDB files -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
