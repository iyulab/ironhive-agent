<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- IronHive (LLM abstraction) -->
    <PackageVersion Include="IronHive.Abstractions" Version="0.20.0" />
    <!-- Ironbees (multi-agent orchestration) -->
    <PackageVersion Include="Ironbees.Core" Version="0.13.1" />
    <PackageVersion Include="Ironbees.Autonomous" Version="0.13.1" />
    <!-- TokenMeter (token counting, multi-provider pricing) -->
    <PackageVersion Include="TokenMeter" Version="0.7.0" />
    <!-- Microsoft.Extensions.AI -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <!-- OpenAI SDK -->
    <PackageVersion Include="ModelContextProtocol" Version="1.3.0" />
    <PackageVersion Include="OpenAI" Version="2.10.0" />
    <!-- DI -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <!-- Diff -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <!-- Glob -->
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
    <!-- YAML Config -->
    <PackageVersion Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <!-- IndexThinking (token management, reasoning extraction) -->
    <PackageVersion Include="IndexThinking" Version="0.21.1" />
    <!-- Security pin: override transitive Microsoft.Bcl.Memory 9.0.4 (NU1903 / GHSA-73j8-2gch-69rq,
         CVE-2026-26127 Base64Url OOB-read DoS). Patched in 10.0.4+; pin 10.0.8 so consumers with
         TreatWarningsAsErrors do not inherit the advisory transitively. -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.8" />
    <!-- MemoryIndexer (conversation memory, session management) -->
    <PackageVersion Include="MemoryIndexer" Version="0.16.5" />
    <PackageVersion Include="MemoryIndexer.Sdk" Version="0.16.5" />
    <!-- FluxGuard (opt-in MCP tool-call guardrail — see IronHive.Agent.Mcp.McpPluginManager) -->
    <PackageVersion Include="FluxGuard.Remote" Version="0.13.0" />
    <!-- DeepResearch dependencies -->
    <PackageVersion Include="WebFlux" Version="0.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Polly" Version="8.6.6" />
    <PackageVersion Include="Polly.Extensions" Version="8.6.6" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>